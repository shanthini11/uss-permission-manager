# Permission Tracker R8 keep rules.
# Libraries (Firebase, kotlinx.serialization, AndroidX) ship their own consumer rules.

# Enum constant names are stored (saved state, navigation arguments) and parsed back with valueOf(),
# so keep their names stable across builds.
-keepclassmembers enum com.group8.permissionmanagerapp_uss.** {
    <fields>;
    public static **[] values();
    public static ** valueOf(java.lang.String);
}

# Strip verbose/debug logging calls from release builds (defence in depth: the app doesn't log
# personal data, but libraries might).
-assumenosideeffects class android.util.Log {
    public static int v(...);
    public static int d(...);
    public static int i(...);
}
