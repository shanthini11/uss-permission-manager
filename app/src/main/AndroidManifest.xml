<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Needed so the Permission Tracker can list every installed app and the permissions it holds.
        This is the core purpose of the app (Google Play allows it for permission/device managers).
    -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Alerts when an app's permissions change, and the weekly review reminder (asked at runtime). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android 12+: lets us hide other apps' overlays while our window is showing (anti-tapjacking). -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />

    <!-- Android 14+: lets us tell the user why a screenshot attempt was blocked (normal permission). -->
    <uses-permission android:name="android.permission.DETECT_SCREEN_CAPTURE" />

    <!--
        Fully offline: strip any network permission a library might merge in, so the app physically
        cannot send data anywhere. Check with: aapt dump permissions app-release.apk
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" tools:node="remove" />

    <!-- Fingerprint / face / screen-lock prompt (normal permission, added by androidx.biometric). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!--
        Security: allowBackup is off so permission history and account data are never copied
        to cloud backups or other devices without the user's explicit export (Backup & Restore screen).
    -->
    <application
        android:name=".PermissionManagerApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:icon="@drawable/ic_app_icon"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_app_icon_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PermissionManagerAppUSS">
        <!--
            exported=true is required for the launcher icon only; the activity reads nothing from
            incoming intents except one boolean. taskAffinity="" prevents task hijacking (StrandHogg).
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:taskAffinity=""
            android:label="@string/app_name"
            android:theme="@style/Theme.PermissionManagerAppUSS"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
