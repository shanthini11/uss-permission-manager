<?xml version="1.0" encoding="utf-8"?>
<!--
    Defence in depth: the app has no INTERNET permission and makes no network calls. If a future
    change ever added networking, this still forces HTTPS and ignores user-installed CAs.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
